[Unit]
Description=Sinty OS update status responder (serves /run/updated.sock for the UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=singularity-session
ExecStart=/usr/libexec/updated serve
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical.target
